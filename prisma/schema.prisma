generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum role {
  superadmin // rol solo para el dueño de todo el sistema
  user
  admin
}

model usuario {
  id             Int      @id @default(autoincrement())
  createdat      DateTime @default(now())
  email          String   @unique
  nombrecompleto String?
  apellidos      String?
  clave          String?
  activo         Boolean? @default(true)
  fotografia     String?
  rol            role     @default(user)
  empresaid      Int?
  empresa        empresa? @relation(fields: [empresaid], references: [idempresa])
}

model empresa {
  idempresa           Int         @id @default(autoincrement())
  nombreempresa       String
  direccion           String
  emailcorporativo    String?
  telefono            String?
  iva                 String?
  nit                 String
  nrc                 String
  codActividad        String
  descActividad       String
  nombreComercial     String?
  tipoEstablecimiento String
  departamento        String
  municipio           String
  complemento         String
  codEstable          String
  codPuntoVenta       String
  createdat           DateTime    @default(now())
  usuarios            usuario[]
  productos           producto[]
  compras             compra[]
  ventas              venta[]
  proveedores         proveedor[]
  clientes            cliente[]
}

model cliente {
  idcliente     Int      @id @default(autoincrement())
  fecharegistro DateTime @default(now())
  nombre        String
  telefono      String?
  direccion     String?
  email         String
  tipoDocumento String? // 37 para consumidor final, otros para contribuyentes
  numDocumento  String? // NIT o DUI
  nrc           String? // Número de registro de contribuyente
  codActividad  String?
  descActividad String?
  departamento  String?
  municipio     String?
  ventas        venta[]
  empresaid     Int?
  empresa       empresa? @relation(fields: [empresaid], references: [idempresa])
}

model producto {
  id          Int             @id @default(autoincrement())
  nombre      String
  precio      Float
  existencias Int
  codigo      String?         @default("47")
  createdat   DateTime        @default(now())
  empresaid   Int //Para saber a que empresa pertenece
  empresa     empresa         @relation(fields: [empresaid], references: [idempresa])
  ventas      ventadetalle[]
  compras     compradetalle[]
}

model venta {
  id        Int            @id @default(autoincrement())
  tipoventa Int            @default(1) // para saber si sera cf ccf exportacion, etc
  fecha     DateTime       @default(now())
  total     Float
  detalles  ventadetalle[]
  empresaid Int //Para saber a que empresa pertenece
  clienteid Int //para saber a que cliente
  pdf       String?
  empresa   empresa        @relation(fields: [empresaid], references: [idempresa])
  cliente   cliente        @relation(fields: [clienteid], references: [idcliente])

  // Nuevos campos según JSON
  version          Int     @default(1)
  ambiente         String  @default("00")
  tipoDte          String  @default("01")
  numeroControl    String? @unique
  codigoGeneracion String? @unique
  tipoModelo       Int     @default(1)
  tipoOperacion    Int     @default(1)
  tipoContingencia String?
  motivoContin     String?
  horEmi           String?
  tipoMoneda       String  @default("USD")

  // Campos del resumen
  totalNoSuj          Float   @default(0)
  totalExenta         Float   @default(0)
  totalGravada        Float   @default(0)
  subTotalVentas      Float   @default(0)
  descuNoSuj          Float   @default(0)
  descuExenta         Float   @default(0)
  descuGravada        Float   @default(0)
  porcentajeDescuento Float   @default(0)
  totalDescu          Float   @default(0)
  subTotal            Float   @default(0)
  ivaRete1            Float   @default(0)
  ivaPerci1           Float   @default(0)
  reteRenta           Float   @default(0)
  montoTotalOperacion Float   @default(0)
  totalNoGravado      Float   @default(0)
  totalPagar          Float   @default(0)
  totalLetras         String?
  totalIva            Float   @default(0)
  saldoFavor          Float   @default(0)
  condicionOperacion  Int     @default(1)
  numPagoElectronico  String? @default("0")

  // Campos de extensión
  nombEntrega   String?
  docuEntrega   String?
  nombRecibe    String?
  docuRecibe    String?
  observaciones String?
  placaVehiculo String?
}

model ventadetalle {
  id         Int      @id @default(autoincrement())
  cantidad   Float // Cambiado a Float para permitir decimales
  precio     Float
  productoid Int
  ventaid    Int
  producto   producto @relation(fields: [productoid], references: [id])
  venta      venta    @relation(fields: [ventaid], references: [id])

  // Nuevos campos según JSON
  numItem         Int
  tipoItem        Int     @default(1)
  numeroDocumento String?
  codigo          String?
  codTributo      String?
  uniMedida       Int     @default(59)
  descripcion     String
  precioUni       Float
  montoDescu      Float   @default(0)
  ventaNoSuj      Float   @default(0)
  ventaExenta     Float   @default(0)
  ventaGravada    Float   @default(0)
  tributos        String? // JSON string para almacenar array de tributos
  psv             Float   @default(0)
  noGravado       Float   @default(0)
  ivaItem         Float   @default(0)
}

model proveedor {
  id                  Int      @id @default(autoincrement())
  fecharegistro       DateTime @default(now())
  nombre              String
  nombreComercial     String?
  nit                 String
  nrc                 String?
  codActividad        String?
  descActividad       String?
  direccion           String
  telefono            String
  email               String
  emailcorporativo    String?
  estado              String   @default("ACTIVO")
  tipoProveedor       String   @default("NACIONAL")
  departamento        String?
  municipio           String?
  complemento         String?
  tipoEstablecimiento String   @default("MATRIZ")
  codEstable          String?
  codPuntoVenta       String?
  iva                 String?
  empresaid           Int
  empresa             empresa  @relation(fields: [empresaid], references: [idempresa])
  compras             compra[]
}

model compra {
  id            Int             @id @default(autoincrement())
  fecha         DateTime        @default(now())
  total         Float
  iva           Float
  numerofactura Int
  empresaid     Int //Para saber a que empresa pertenece
  proveedorid   Int //Para saber a que proveedor ha comprado
  empresa       empresa         @relation(fields: [empresaid], references: [idempresa])
  proveedor     proveedor       @relation(fields: [proveedorid], references: [id])
  detalles      compradetalle[]
}

model compradetalle {
  id         Int      @id @default(autoincrement())
  cantidad   Int
  precio     Float
  productoid Int
  compraid   Int
  producto   producto @relation(fields: [productoid], references: [id])
  compra     compra   @relation(fields: [compraid], references: [id])
}
